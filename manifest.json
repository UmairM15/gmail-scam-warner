{
  "manifest_version": 3,
  "name": "Gmail Scam Warner",
  "version": "1.0.0",
  "description": "Warns users when a suspicious or scam email is detected in Gmail.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://mail.google.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
